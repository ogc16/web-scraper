# awsa runs with ZERO configuration out of the box.
# Every variable below is optional and only needed to upgrade to a hosted provider.
# Never commit a populated .env — see .gitignore.

# ---------------------------------------------------------------------------
# LLM (leave unset to use the deterministic offline extractor)
# Any OpenAI-compatible endpoint works, including local ones.
# ---------------------------------------------------------------------------
AWSA_OPENAI_API_KEY=
AWSA_OPENAI_BASE_URL=https://api.openai.com/v1
AWSA_LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Search providers (default needs no key: the DuckDuckGo HTML endpoint)
# ---------------------------------------------------------------------------
AWSA_BRAVE_API_KEY=

# ---------------------------------------------------------------------------
# Unblocking proxy (optional) — e.g. when a target sits behind bot protection.
# ---------------------------------------------------------------------------
AWSA_BRIGHTDATA_API_TOKEN=
AWSA_BRIGHTDATA_ZONE=
AWSA_BRIGHTDATA_USERNAME=
AWSA_BRIGHTDATA_PASSWORD=

AWSA_FIRECRAWL_API_KEY=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
AWSA_USER_AGENT=awsa/0.1 (+https://github.com/ogc16/web-scraper)
# Comma-separated extra agents, rotated per request. Left empty on purpose: one
# stable, identifiable agent is the default and the intended behaviour. Setting
# this presents several identities, which is how bot detection spots automation.
AWSA_USER_AGENT_ROTATION=
AWSA_CACHE_DIR=
AWSA_LOG_LEVEL=INFO
# Ignore hosted/paid providers and use the keyless stack. Network is still used.
AWSA_OFFLINE=false
# Open no sockets at all; answer from a warm cache only. Implies AWSA_OFFLINE.
AWSA_NO_NETWORK=false
